# Supabase project settings (Project Settings -> API in het Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NOOIT naar de client sturen, alleen server-side gebruikt (admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) voor transactionele e-mail (nieuw bericht / zorggesprek)
RESEND_API_KEY=
EMAIL_FROM="Royal Mission Portal <noreply@jouw-domein.nl>"

# Basis-URL van de app, gebruikt in e-maillinks
NEXT_PUBLIC_APP_URL=http://localhost:3000
