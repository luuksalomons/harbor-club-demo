# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NEVER send to the client, server-side only (admin.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the app, used in email mock logs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret that authorizes calls to /api/demo/reset (Vercel Cron sends
# this automatically as a Bearer token once set as a Vercel env var)
CRON_SECRET=

# Password assigned to the 3 fixed demo accounts, and the same value shown
# on the login page (src/app/login/page.tsx reads this too — NEXT_PUBLIC_
# so it's readable client-side; there is only one source of truth now)
NEXT_PUBLIC_DEMO_PASSWORD=HarborDemo2026!
